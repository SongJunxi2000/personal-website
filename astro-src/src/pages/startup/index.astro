---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectIndex from '../../components/ProjectIndex.astro';

const modules = import.meta.glob('../../content/startup/*.md', { eager: true });

const posts = Object.entries(modules)
  .map(([path, mod]: [string, any]) => ({
    slug: path.split('/').pop()?.replace('.md', '') ?? '',
    title: mod.frontmatter.title,
    date: mod.frontmatter.date,
    excerpt: mod.frontmatter.excerpt,
    url: `/startup/${path.split('/').pop()?.replace('.md', '')}`,
  }))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<BaseLayout
  title="Startup"
  description="Notes on building products, finding customers, and learning what people need."
  project="startup"
>
  <ProjectIndex
    project="startup"
    title="Startup"
    intro="Notes from building and trying to sell. On products, customers, and the distance between what we can make and what people need."
    posts={posts}
  />
</BaseLayout>
